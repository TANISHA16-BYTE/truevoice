{
  "name": "truevoice-backend",
  "version": "1.0.0",
  "description": "TrueVoice: Content Safety Check & Verification API before publication",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node src/db/seed.js",
    "test": "node tests/api.test.js",
    "benchmark": "node tests/benchmark_40_sentences.js",
    "seed:postgres": "node --env-file-if-exists=.env src/db/seed-postgres.js"
  },
  "keywords": [
    "truevoice",
    "content-safety",
    "compliance",
    "hackathon",
    "gemini",
    "devvibe"
  ],
  "author": "Tanisha Jain (Backend Lead, Team DevVibe)",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.16.3"
  }
}
